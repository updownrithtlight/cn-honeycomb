---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { siteInfo } from "../../data/site";

const canonical = `${siteInfo.domain}terms/`;
---
<BaseLayout title="使用条款 | 恒实蜂窝" description="恒实蜂窝中文网站的信息使用、产品参数、知识产权和责任边界说明。" canonical={canonical}>
  <section class="section">
    <div class="container legal-page">
      <Breadcrumb items={[{ label: "使用条款" }]} />
      <h1>使用条款</h1>
      <p>更新日期：2026 年 6 月 11 日</p>
      <h2>网站信息</h2>
      <p>网站内容用于产品和定制能力介绍，不构成对特定项目性能、交期或适用性的保证。最终方案以双方确认的图纸、技术协议、样品、报价或合同为准。</p>
      <h2>工程参数</h2>
      <p>材料、孔径、箔厚、尺寸、屏蔽、整流和密封性能会受到结构、工况、安装和测试条件影响。采购前应完成项目评审和必要验证。</p>
      <h2>附件与询盘</h2>
      <p>您应确保有权提交相关图纸和资料。请不要上传违法内容、恶意文件或与询盘无关的信息。网站可拒绝无法验证或不符合要求的提交。</p>
      <h2>知识产权</h2>
      <p>本站品牌、文字、页面设计及自有图片受适用法律保护。未经书面许可，不得用于误导性宣传或冒充本公司。</p>
      <h2>联系</h2>
      <p>条款相关问题请联系 <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a>。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page { max-width: 860px; }
  h1 { margin: 28px 0 18px; color: var(--color-primary); font-size: clamp(34px, 5vw, 52px); }
  h2 { margin: 32px 0 10px; color: var(--color-primary); font-size: 22px; }
  p { color: var(--color-muted); }
  a { color: var(--color-primary-light); text-decoration: underline; }
</style>
