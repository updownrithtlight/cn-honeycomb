---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TechnicalArticleCard from "../../components/TechnicalArticleCard.astro";
import CTASection from "../../components/CTASection.astro";
import { siteInfo } from "../../data/site";

const articles = (await getCollection("technical")).sort(
  (a, b) => b.data.publishDate.localeCompare(a.data.publishDate) || a.data.title.localeCompare(b.data.title, "zh-CN")
);

const title = "技术文章 | 金属蜂窝芯、整流蜂窝、EMI屏蔽通风板选型资料";
const description = "面向中国工程师、设计人员、设备厂和技术采购的金属蜂窝定制、材料选型、制造、检测与询价技术文章。";
const canonical = `${siteInfo.domain}technical/`;
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <section class="technical-hero">
    <div class="container technical-hero__grid">
      <div>
        <Breadcrumb items={[{ label: "技术文章" }]} />
        <p class="eyebrow">Engineering Articles</p>
        <h1>金属蜂窝技术文章</h1>
        <p class="section-lead">面向工程选型、图纸评审和技术采购，整理金属蜂窝芯、整流蜂窝、EMI 屏蔽通风板、蜂窝密封的参数与制造要点。</p>
      </div>
      <aside>
        <strong>阅读建议</strong>
        <p>先按应用场景确认材料、孔径、箔厚、蜂窝深度、外形与检测要求，再结合图纸进行可制造性评估。</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Technical Library</p>
        <h2 class="section-title">选型、应用与质量控制</h2>
        <p class="section-lead">文章以工程说明和采购确认事项为主。性能数据应结合实际结构、工况、样件或项目检测结果确认。</p>
      </div>
      <div class="article-grid">
        {articles.map((article) => <TechnicalArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container link-grid">
      <a href="/products/"><strong>查看产品中心</strong><span>核对金属蜂窝芯、整流蜂窝、屏蔽通风板和蜂窝密封的真实产品页面。</span></a>
      <a href="/about/"><strong>了解制造与质量体系</strong><span>查看生产现场、工艺能力和企业资质认证。</span></a>
      <a href="/contact/"><strong>提交图纸与参数</strong><span>提供用途、材料、孔径、箔厚、尺寸、数量和检测要求。</span></a>
    </div>
  </section>

  <CTASection title="需要结合图纸确认金属蜂窝方案？" lead="请提供用途、材料、孔径、箔厚、蜂窝厚度、外形尺寸、数量和检测要求。" />
</BaseLayout>

<style>
  .technical-hero {
    padding: 44px 0 68px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-soft);
  }

  .technical-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 42px;
    align-items: end;
  }

  h1 {
    max-width: 820px;
    margin: 12px 0 16px;
    color: var(--color-primary);
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.16;
  }

  .technical-hero aside {
    padding: 24px;
    border-left: 4px solid var(--color-accent);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .technical-hero aside strong {
    color: var(--color-primary);
    font-size: 18px;
  }

  .technical-hero aside p {
    margin: 8px 0 0;
    color: var(--color-muted);
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .link-grid a {
    display: grid;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--color-border);
    background: #fff;
  }

  .link-grid strong {
    color: var(--color-primary);
    font-size: 19px;
  }

  .link-grid span {
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .technical-hero__grid,
    .article-grid,
    .link-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
