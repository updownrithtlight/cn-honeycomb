---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import CTASection from "../../../components/CTASection.astro";
import { newsItems, type NewsItem } from "../../../data/news";
import { siteInfo } from "../../../data/site";

export function getStaticPaths() {
  const sortedNews = [...newsItems].sort((a, b) => b.date.localeCompare(a.date));
  return sortedNews.map((article, index) => ({
    params: { slug: article.slug },
    props: {
      article,
      previousArticle: sortedNews[index + 1] ?? null,
      nextArticle: sortedNews[index - 1] ?? null
    }
  }));
}

const { article, previousArticle, nextArticle } = Astro.props as {
  article: NewsItem;
  previousArticle: NewsItem | null;
  nextArticle: NewsItem | null;
};
const canonical = `${siteInfo.domain}news/${article.slug}/`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  datePublished: article.date,
  dateModified: article.date,
  description: article.excerpt,
  image: article.images.map((image) => `${siteInfo.domain}${image.src.replace(/^\//, "")}`),
  mainEntityOfPage: canonical,
  author: { "@type": "Organization", name: siteInfo.companyName, url: siteInfo.domain },
  publisher: { "@type": "Organization", name: siteInfo.companyName, url: siteInfo.domain }
};
---
<BaseLayout title={`${article.title} | 恒实蜂窝`} description={article.excerpt} canonical={canonical} jsonLd={[articleJsonLd]}>
  <article>
    <header class="article-header">
      <div class="container">
        <Breadcrumb items={[{ href: "/news/", label: "企业新闻" }, { label: article.title }]} />
        <p class="eyebrow">{article.category}</p>
        <h1>{article.title}</h1>
        <time datetime={article.date}>{article.date}</time>
      </div>
    </header>
    <div class="container article-layout">
      <div class="article-body">
        {article.images[0] && <figure class="lead-image"><img src={article.images[0].src} alt={article.images[0].alt} width="1200" height="750" decoding="async" /><figcaption>{article.images[0].caption}</figcaption></figure>}
        <p class="article-lead">{article.excerpt}</p>
        {article.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {article.images.length > 1 && <div class="gallery">{article.images.slice(1).map((image) => <figure><img src={image.src} alt={image.alt} width="1200" height="750" loading="lazy" decoding="async" /><figcaption>{image.caption}</figcaption></figure>)}</div>}
        {article.sourceUrl && <p class="source">资料来源：<a href={article.sourceUrl} rel="noopener noreferrer">恒实蜂窝英文官网</a></p>}
        <nav class="article-nav" aria-label="新闻文章导航">
          <div>
            <span>上一篇</span>
            {previousArticle ? <a href={`/news/${previousArticle.slug}/`}>{previousArticle.title}</a> : <p>已经是最早一篇</p>}
          </div>
          <div class="article-nav-next">
            <span>下一篇</span>
            {nextArticle ? <a href={`/news/${nextArticle.slug}/`}>{nextArticle.title}</a> : <p>已经是最新一篇</p>}
          </div>
        </nav>
      </div>
    </div>
  </article>
  <CTASection title="咨询金属蜂窝产品与定制方案" lead="请提供应用场景、材料、尺寸、图纸和数量，便于开展工程评估。" />
</BaseLayout>

<style>
  .article-header { padding: 44px 0 52px; border-bottom: 1px solid var(--color-border); background: var(--color-bg-soft); }
  .article-header .eyebrow { margin-top: 28px; }
  h1 { max-width: 980px; margin: 10px 0 14px; color: var(--color-primary); font-size: clamp(34px, 5vw, 52px); line-height: 1.2; letter-spacing: 0; }
  time { color: var(--color-muted); }
  .article-layout { padding-top: 56px; padding-bottom: 72px; }
  .article-body { max-width: 820px; }
  .article-body > p { margin: 0 0 20px; color: var(--color-text); font-size: 17px; }
  .article-lead { color: var(--color-primary) !important; font-size: 20px !important; font-weight: 700; }
  figure { margin: 0; }
  figure img { display: block; width: 100%; height: auto; }
  figcaption { padding: 8px 0 0; color: var(--color-muted); font-size: 13px; }
  .lead-image { max-width: 760px; margin-bottom: 30px; }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 34px; }
  .source { margin-top: 28px !important; padding-top: 18px; border-top: 1px solid var(--color-border); color: var(--color-muted) !important; font-size: 14px !important; }
  .source a { color: var(--color-primary-light); text-decoration: underline; }
  .article-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 42px; padding-top: 24px; border-top: 1px solid var(--color-border); }
  .article-nav div { display: grid; gap: 7px; min-width: 0; }
  .article-nav span { color: var(--color-muted); font-size: 13px; font-weight: 800; }
  .article-nav a { color: var(--color-primary); font-weight: 800; line-height: 1.5; }
  .article-nav a:hover { color: var(--color-accent-dark); }
  .article-nav p { margin: 0; color: var(--color-muted); font-size: 14px; }
  .article-nav-next { text-align: right; }
  @media (max-width: 640px) {
    .gallery { grid-template-columns: 1fr 1fr; }
    .article-nav { grid-template-columns: 1fr; }
    .article-nav-next { text-align: left; }
  }
</style>
