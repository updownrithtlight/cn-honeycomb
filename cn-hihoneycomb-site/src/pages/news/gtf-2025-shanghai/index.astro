---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import CTASection from "../../../components/CTASection.astro";
import { newsBySlug } from "../../../data/news";
import { siteInfo } from "../../../data/site";

const article = newsBySlug["gtf-2025-shanghai"];
const canonical = `${siteInfo.domain}news/${article.slug}/`;
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: article.title,
  datePublished: article.date,
  dateModified: article.date,
  description: article.excerpt,
  image: `${siteInfo.domain}images/placeholder-workshop.svg`,
  mainEntityOfPage: canonical,
  author: {
    "@type": "Organization",
    name: siteInfo.companyName,
    url: siteInfo.domain
  },
  publisher: {
    "@type": "Organization",
    name: siteInfo.companyName,
    url: siteInfo.domain
  }
};
---
<BaseLayout title={`${article.title} | 恒实蜂窝`} description={article.excerpt} canonical={canonical} jsonLd={[articleJsonLd]}>
  <article>
    <header class="article-header">
      <div class="container">
        <Breadcrumb items={[{ href: "/news/", label: "企业新闻" }, { label: article.title }]} />
        <p class="eyebrow">{article.category}</p>
        <h1>{article.title}</h1>
        <time datetime={article.date}>{article.date}</time>
      </div>
    </header>
    <div class="container article-layout">
      <div class="article-body">
        <img src="/images/placeholder-workshop.svg" alt="恒实蜂窝参加 GTF 2025 上海展会占位图" />
        <p class="article-lead">{article.excerpt}</p>
        {article.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="source">
          英文官网来源：
          <a href={article.sourceUrl} rel="noopener noreferrer">Hengshi Honeycomb Showcases at GTF 2025 in Shanghai</a>
        </p>
      </div>
    </div>
  </article>
  <CTASection />
</BaseLayout>

<style>
  .article-header {
    padding: 44px 0 52px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-soft);
  }

  .article-header .eyebrow {
    margin-top: 28px;
  }

  h1 {
    max-width: 900px;
    margin: 10px 0 14px;
    color: var(--color-primary);
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.2;
    letter-spacing: 0;
  }

  time {
    color: var(--color-muted);
  }

  .article-layout {
    padding-top: 56px;
    padding-bottom: 72px;
  }

  .article-body {
    max-width: 820px;
  }

  .article-body img {
    width: 100%;
    margin-bottom: 30px;
    border: 1px solid var(--color-border);
  }

  .article-body p {
    margin: 0 0 20px;
    color: var(--color-text);
    font-size: 17px;
  }

  .article-lead {
    color: var(--color-primary) !important;
    font-size: 20px !important;
    font-weight: 700;
  }

  .source {
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted) !important;
    font-size: 14px !important;
  }

  .source a {
    color: var(--color-primary-light);
    text-decoration: underline;
  }
</style>
