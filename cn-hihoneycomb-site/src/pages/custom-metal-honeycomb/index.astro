---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ParameterTable from "../../components/ParameterTable.astro";
import FAQ from "../../components/FAQ.astro";
import CTASection from "../../components/CTASection.astro";
import { productsBySlug } from "../../data/products";
import { inquiryFields } from "../../data/site";

const product = productsBySlug["custom-metal-honeycomb"];
const rows = [
  { label: "可定制材料", value: product.materials.join("、") },
  { label: "孔径 / Cell Size", value: "根据图纸、样品或流体 / 屏蔽应用要求沟通。" },
  { label: "箔厚 / Foil Thickness", value: "根据材料、结构强度、焊接方式和使用环境确认。" },
  { label: "蜂窝厚度 / Depth", value: "根据安装空间、整流或屏蔽需求、密封结构确认。" },
  { label: "形状", value: "矩形、圆形、环形、异形结构或按图纸定制。" },
  { label: "边框", value: "可沟通边框材料、固定孔、装配结构和密封方式。" },
  { label: "表面处理", value: "结合材料和应用环境沟通表面处理要求。" }
];

const flow = [
  ["提交图纸或草图", "提供应用场景、尺寸、孔径、厚度、材料和数量。"],
  ["确认结构参数", "沟通边框、安装方式和表面处理。"],
  ["评估加工方案", "结合材料、工艺和数量评估样品或生产方案。"],
  ["生产与交付", "按确认资料推进加工、检验和交付沟通。"]
];
---
<BaseLayout title={product.title} description={product.description} canonical={`https://cn.hihoneycomb.com/${product.slug}/`}>
  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: "定制能力" }]} />
      <div class="section-head page-head">
        <p class="eyebrow">Custom Metal Honeycomb</p>
        <h1 class="section-title">金属蜂窝定制能力</h1>
        <p class="section-lead">围绕材料、孔径、箔厚、蜂窝厚度、形状、边框、表面处理和图纸定制流程，为工业工程应用沟通金属蜂窝方案。</p>
      </div>
      <ParameterTable rows={rows} />
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Drawing Based</p>
        <h2 class="section-title">图纸定制流程</h2>
      </div>
      <ol class="flow-list">
        {flow.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container inquiry-grid">
      <div>
        <div class="section-head">
          <p class="eyebrow">Inquiry Parameters</p>
          <h2 class="section-title">询价参数</h2>
          <p class="section-lead">参数越明确，越便于判断材料、工艺、结构和交期。</p>
        </div>
      </div>
      <ul class="param-list">
        {inquiryFields.map((field) => <li>{field}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2 class="section-title">定制常见问题</h2>
      </div>
      <FAQ items={product.faq} />
    </div>
  </section>

  <CTASection title="准备沟通金属蜂窝定制件？" lead="请提供用途、材质、孔径、箔厚、蜂窝厚度、尺寸、图纸或草图和数量。" />
</BaseLayout>

<style>
  .page-head {
    margin-top: 24px;
  }

  .flow-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: flow;
  }

  .flow-list li {
    counter-increment: flow;
    display: grid;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--color-border);
    background: #fff;
  }

  .flow-list li::before {
    content: counter(flow, decimal-leading-zero);
    color: var(--color-accent-dark);
    font-weight: 900;
  }

  .flow-list strong {
    color: var(--color-primary);
    font-size: 19px;
  }

  .flow-list span {
    color: var(--color-muted);
  }

  .inquiry-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 34px;
  }

  .param-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .param-list li {
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .flow-list,
    .inquiry-grid,
    .param-list {
      grid-template-columns: 1fr;
    }
  }
</style>
