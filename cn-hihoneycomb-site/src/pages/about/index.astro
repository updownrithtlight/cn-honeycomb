---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ParameterTable from "../../components/ParameterTable.astro";
import CTASection from "../../components/CTASection.astro";
import { siteInfo } from "../../data/site";
import { companyProfile } from "../../data/company";
import { pageSEO } from "../../data/seo";

const rows = [
  { label: "公司名称", value: siteInfo.companyName },
  { label: "品牌", value: `${siteInfo.siteName} / ${siteInfo.brandEnglish}` },
  { label: "企业定位", value: companyProfile.positioning },
  { label: "产品方向", value: "电磁屏蔽蜂窝、风洞试验蜂窝、航空航天发动机及燃气轮机相关金属蜂窝。" },
  { label: "工艺能力", value: companyProfile.processCapabilities.join("、") }
];

const manufacturingScenes = [
  {
    image: "/images/company/cnc-equipment-operation.webp",
    title: "设备操作",
    description: "生产人员进行设备参数设置与加工操作。"
  },
  {
    image: "/images/company/welding-production.webp",
    title: "焊接加工",
    description: "制造现场开展金属构件焊接作业。"
  },
  {
    image: "/images/company/product-inspection.webp",
    title: "过程检验",
    description: "生产过程中对工件尺寸和加工状态进行检查。"
  },
  {
    image: "/images/company/materials-storage.webp",
    title: "物料管理",
    description: "车间物料与工装按区域分类存放。"
  }
];

const certificates = [
  {
    image: "/images/certificates/as9100d-cn.webp",
    title: "航空航天质量管理体系认证",
    standard: "HB 9100-2023 / AS 9100D",
    detail: "中文证书 · 有效期至 2028 年 9 月 8 日",
    href: "/images/certificates/as9100d-cn.pdf",
    action: "查看中文证书原件"
  },
  {
    image: "/images/certificates/as9100d-en.webp",
    title: "Aerospace Quality Management System",
    standard: "HB 9100-2023 / AS 9100D",
    detail: "英文证书 · 有效期至 2028 年 9 月 8 日",
    href: "/images/certificates/as9100d-en.pdf",
    action: "查看英文证书原件"
  },
  {
    image: "/images/certificates/iso-9001-2015.webp",
    title: "质量管理体系认证",
    standard: "GB/T 19001-2016 / ISO 9001:2015",
    detail: "认证范围涵盖金属蜂窝产品制造 · 有效期至 2027 年 10 月 11 日",
    href: "/images/certificates/iso-9001-2015.webp",
    action: "查看大图"
  },
  {
    image: "/images/certificates/gjb-9001c-2017.webp",
    title: "武器装备质量管理体系认证",
    standard: "GJB 9001C-2017",
    detail: "认证范围涵盖风洞蜂窝器、蜂窝芯、屏蔽通风板和蜂窝气封制造 · 有效期至 2027 年 10 月 11 日",
    href: "/images/certificates/gjb-9001c-2017.webp",
    action: "查看大图"
  }
];
---
<BaseLayout title={pageSEO.about.title} description={pageSEO.about.description} canonical={pageSEO.about.canonical}>
  <section class="about-hero">
    <div class="container about-hero-grid">
      <div>
      <Breadcrumb items={[{ label: "关于我们" }]} />
      <div class="section-head page-head">
        <p class="eyebrow">About Hengshi</p>
        <h1 class="section-title">关于恒实蜂窝</h1>
        <p class="section-lead">{siteInfo.description}</p>
      </div>
        <div class="about-highlights">
          <span>研发与制造协同</span>
          <span>金属蜂窝专业生产</span>
          <span>支持按图沟通定制</span>
        </div>
      </div>
      <figure class="hero-photo">
        <img src="/images/company/hengshi-factory-exterior-optimized.webp" alt="恒实蜂窝厂区外观" width="1920" height="1080" loading="eager" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container company-intro-grid">
      <div>
        <div class="section-head">
          <p class="eyebrow">Company Profile</p>
          <h2 class="section-title">面向工程应用的金属蜂窝制造企业</h2>
          <p class="section-lead">围绕电磁屏蔽、气流整流、风洞试验和动力设备密封等需求，开展材料选择、结构沟通、生产加工与项目交付。</p>
        </div>
        <ParameterTable rows={rows} />
      </div>
      <figure class="workshop-photo">
        <img src="/images/company/hengshi-workshop-overview-optimized.webp" alt="恒实蜂窝生产车间全景" width="1920" height="1080" loading="lazy" decoding="async" />
        <figcaption>生产车间与设备布局</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Business Areas</p>
        <h2 class="section-title">主营业务方向</h2>
      </div>
      <div class="grid grid--3">
        {companyProfile.businessAreas.map((item) => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Manufacturing Scene</p>
        <h2 class="section-title">生产制造现场</h2>
        <p class="section-lead">从设备操作、焊接加工、过程检验到物料管理，展示金属蜂窝产品的实际制造环境。</p>
      </div>
      <div class="scene-grid">
        {manufacturingScenes.map((scene) => (
          <article class="scene-card">
            <img src={scene.image} alt={scene.title} width="1280" height="720" loading="lazy" decoding="async" />
            <div><h3>{scene.title}</h3><p>{scene.description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container capability-grid">
      <div>
        <div class="section-head">
          <p class="eyebrow">Manufacturing</p>
          <h2 class="section-title">材料与制造能力</h2>
          <p class="section-lead">围绕材料、箔厚、蜂窝孔径、拼焊、钎焊、冲压成型和边框焊接等环节，支持按图纸沟通定制。</p>
        </div>
        <div class="tag-list">
          {companyProfile.materials.map((item) => <span>{item}</span>)}
        </div>
      </div>
      <aside class="info-panel">
        <h3>工艺沟通范围</h3>
        <ul>
          {companyProfile.processCapabilities.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container people-grid">
      <figure class="people-photo">
        <img src="/images/company/engineering-review.webp" alt="恒实蜂窝工程团队开展方案评审" width="1280" height="720" loading="lazy" decoding="async" />
      </figure>
      <div>
        <div class="section-head">
          <p class="eyebrow">Engineering Collaboration</p>
          <h2 class="section-title">从需求沟通到工程评审</h2>
          <p class="section-lead">针对材料、孔径、箔厚、蜂窝深度、外形尺寸、边框结构和应用环境进行沟通，并结合图纸或样品开展加工方案评估。</p>
        </div>
        <ul class="workflow-list">
          <li><strong>需求确认</strong><span>明确使用环境、结构尺寸和性能关注点。</span></li>
          <li><strong>方案评估</strong><span>围绕材料、工艺和装配方式进行工程沟通。</span></li>
          <li><strong>生产与检验</strong><span>按确认要求组织加工并开展过程检查。</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section certification-section" id="certifications">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Quality Certifications</p>
        <h2 class="section-title">资质认证与质量体系</h2>
        <p class="section-lead">围绕航空航天、装备制造和通用工业质量管理要求建立质量体系。证书信息以认证机构签发文件及持续监督审核结果为准。</p>
      </div>
      <div class="certificate-grid">
        {certificates.map((certificate) => (
          <article class="certificate-card">
            <a class="certificate-preview" href={certificate.href} target="_blank" rel="noreferrer" aria-label={`${certificate.action}：${certificate.title}`}>
              <img src={certificate.image} alt={`${certificate.title}证书`} width="990" height="1400" loading="lazy" decoding="async" />
              <span>查看证书</span>
            </a>
            <div class="certificate-copy">
              <p class="certificate-standard">{certificate.standard}</p>
              <h3>{certificate.title}</h3>
              <p>{certificate.detail}</p>
              <a href={certificate.href} target="_blank" rel="noreferrer">{certificate.action} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
      <div class="certification-note">
        <strong>认证范围说明</strong>
        <span>AS9100D / HB 9100-2023 认证范围包括精密机械及其部件制造，涉及整流器、金属蜂窝、蜂窝气封和蜂窝衬套。</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container team-banner">
      <img src="/images/company/hengshi-team-optimized.webp" alt="恒实蜂窝团队合影" width="1920" height="1280" loading="lazy" decoding="async" />
      <div class="team-copy"><p class="eyebrow">Our Team</p><h2>以制造和工程协作为基础</h2><p>团队覆盖生产操作、工艺沟通、质量检查与项目协作，为工业客户提供金属蜂窝产品和定制支持。</p></div>
    </div>
  </section>

  <section class="section">
    <div class="container note-block">
      <div class="section-head">
        <p class="eyebrow">Engineering Notes</p>
        <h2 class="section-title">工程沟通要点</h2>
      </div>
      <p>本站内容以中文采购、工程师、设备厂和设计院阅读习惯组织。涉及屏蔽效能、流场指标、密封效果等性能数据时，应结合图纸、样品和测试条件确认。</p>
      <div class="button-row">
        <a class="button button--ghost" href="/technical/">查看金属蜂窝技术文章</a>
      </div>
    </div>
  </section>

  <CTASection title="了解产品和定制能力" lead="可从产品中心或联系页面提交材料、尺寸、图纸和应用场景。" />
</BaseLayout>

<style>
  .page-head {
    margin-top: 24px;
  }

  .about-hero {
    padding: 42px 0 64px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-soft);
  }

  .about-hero-grid,
  .company-intro-grid,
  .people-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
    gap: 42px;
    align-items: center;
  }

  .hero-photo,
  .workshop-photo,
  .people-photo {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .hero-photo img,
  .workshop-photo img,
  .people-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-highlights { display: flex; flex-wrap: wrap; gap: 10px; }
  .about-highlights span { padding: 8px 11px; border: 1px solid var(--color-border); background: #fff; color: var(--color-primary); font-weight: 700; }
  .company-intro-grid { grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr); align-items: start; }
  .workshop-photo figcaption { padding: 12px 14px; color: var(--color-muted); font-size: 14px; }

  .info-card,
  .note-block,
  .info-panel {
    border: 1px solid var(--color-border);
    background: #fff;
  }

  .info-card {
    padding: 24px;
  }

  .scene-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .scene-card { overflow: hidden; border: 1px solid var(--color-border); background: #fff; box-shadow: var(--shadow-soft); }
  .scene-card img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: contain; background: #f7f8fa; }
  .scene-card div { padding: 20px; }
  .scene-card h3 { margin: 0 0 8px; color: var(--color-primary); }
  .scene-card p { margin: 0; color: var(--color-muted); }

  .compact-card {
    min-height: 118px;
  }

  .info-card h3,
  .info-panel h3 {
    margin: 0 0 10px;
    color: var(--color-primary);
    font-size: 21px;
  }

  .compact-card h3 {
    font-size: 18px;
    line-height: 1.35;
  }

  .info-card p,
  .info-panel p,
  .note-block > p,
  .note-block li,
  .info-panel li {
    color: var(--color-muted);
  }

  .capability-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 32px;
    align-items: start;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag-list span {
    padding: 9px 12px;
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-primary);
    font-weight: 800;
  }

  .info-panel,
  .note-block {
    padding: 28px;
  }

  .info-panel ul,
  .note-block ul {
    display: grid;
    gap: 10px;
    margin: 0 0 18px;
    padding-left: 18px;
  }

  .note-block > p {
    margin: 0;
  }

  .workflow-list { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .workflow-list li { display: grid; gap: 4px; padding: 16px 18px; border-left: 4px solid var(--color-accent); background: #fff; }
  .workflow-list strong { color: var(--color-primary); }
  .workflow-list span { color: var(--color-muted); }

  .certification-section { scroll-margin-top: 96px; }
  .certificate-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .certificate-card { display: flex; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid var(--color-border); background: #fff; box-shadow: var(--shadow-soft); }
  .certificate-preview { position: relative; display: block; overflow: hidden; aspect-ratio: 0.707 / 1; background: #eef1f4; }
  .certificate-preview img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 180ms ease; }
  .certificate-preview > span { position: absolute; right: 12px; bottom: 12px; padding: 6px 10px; background: rgba(11, 42, 74, 0.9); color: #fff; font-size: 13px; font-weight: 800; }
  .certificate-preview:hover img { transform: scale(1.02); }
  .certificate-copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 20px; }
  .certificate-copy h3 { margin: 4px 0 9px; color: var(--color-primary); font-size: 19px; line-height: 1.4; }
  .certificate-copy p { margin: 0 0 16px; color: var(--color-muted); font-size: 14px; }
  .certificate-copy .certificate-standard { margin: 0; color: var(--color-accent-dark); font-weight: 800; }
  .certificate-copy > a { margin-top: auto; color: var(--color-primary); font-weight: 800; }
  .certification-note { display: flex; gap: 14px; margin-top: 22px; padding: 18px 20px; border-left: 4px solid var(--color-accent); background: var(--color-bg-soft); }
  .certification-note strong { flex: 0 0 auto; color: var(--color-primary); }
  .certification-note span { color: var(--color-muted); }

  .team-banner { position: relative; overflow: hidden; min-height: 460px; background: var(--color-primary); }
  .team-banner > img { display: block; width: 100%; height: 460px; object-fit: cover; object-position: center 42%; opacity: 0.72; }
  .team-banner::after { position: absolute; inset: 0; content: ""; background: linear-gradient(90deg, rgba(6, 30, 55, 0.92), rgba(6, 30, 55, 0.16)); }
  .team-copy { position: absolute; z-index: 1; top: 50%; left: clamp(24px, 6vw, 72px); max-width: 520px; transform: translateY(-50%); color: #fff; }
  .team-copy h2 { margin: 6px 0 14px; font-size: clamp(28px, 4vw, 42px); }
  .team-copy p { margin: 0; color: rgba(255,255,255,0.88); }
  .team-copy .eyebrow { color: #fff; }

  @media (max-width: 980px) {
    .about-hero-grid,
    .company-intro-grid,
    .people-grid,
    .capability-grid {
      grid-template-columns: 1fr;
    }

    .certificate-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .scene-grid { grid-template-columns: 1fr; }
    .certificate-grid { grid-template-columns: 1fr; }
    .certification-note { flex-direction: column; gap: 4px; }
    .team-banner, .team-banner > img { min-height: 520px; height: 520px; }
  }
</style>
