---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ParameterTable from "../../components/ParameterTable.astro";
import CTASection from "../../components/CTASection.astro";
import { siteInfo } from "../../data/site";
import { companyProfile } from "../../data/company";
import { pageSEO } from "../../data/seo";

const rows = [
  { label: "公司名称", value: siteInfo.companyName },
  { label: "品牌", value: `${siteInfo.siteName} / ${siteInfo.brandEnglish}` },
  { label: "成立时间", value: `${companyProfile.foundedYear} 年` },
  { label: "生产基地", value: companyProfile.productionBase },
  { label: "企业定位", value: companyProfile.positioning },
  { label: "产品方向", value: "电磁屏蔽蜂窝、风洞试验蜂窝、航空航天发动机及燃气轮机相关金属蜂窝。" },
  { label: "工艺能力", value: companyProfile.processCapabilities.join("、") }
];
---
<BaseLayout title={pageSEO.about.title} description={pageSEO.about.description} canonical={pageSEO.about.canonical}>
  <section class="section">
    <div class="container">
      <Breadcrumb items={[{ label: "关于我们" }]} />
      <div class="section-head page-head">
        <p class="eyebrow">About Hengshi</p>
        <h1 class="section-title">关于恒实蜂窝</h1>
        <p class="section-lead">{siteInfo.description}</p>
      </div>
      <ParameterTable rows={rows} />
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Qualifications</p>
        <h2 class="section-title">资质与企业基础</h2>
        <p class="section-lead">以下信息来自公司彩页资料，后续可继续补充证书图片、证书编号和有效期展示。</p>
      </div>
      <div class="grid grid--4">
        {companyProfile.certifications.map((item) => (
          <article class="info-card compact-card"><h3>{item}</h3></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Business Areas</p>
        <h2 class="section-title">主营业务方向</h2>
      </div>
      <div class="grid grid--3">
        {companyProfile.businessAreas.map((item) => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container capability-grid">
      <div>
        <div class="section-head">
          <p class="eyebrow">Manufacturing</p>
          <h2 class="section-title">材料与制造能力</h2>
          <p class="section-lead">围绕材料、箔厚、蜂窝孔径、拼焊、钎焊、冲压成型和边框焊接等环节，支持按图纸沟通定制。</p>
        </div>
        <div class="tag-list">
          {companyProfile.materials.map((item) => <span>{item}</span>)}
        </div>
      </div>
      <aside class="info-panel">
        <h3>常见箔厚</h3>
        <p>{companyProfile.foilThickness.join("、")}</p>
        <h3>设备与工艺摘要</h3>
        <ul>
          {companyProfile.equipmentHighlights.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container note-block">
      <div class="section-head">
        <p class="eyebrow">Engineering Notes</p>
        <h2 class="section-title">工程沟通要点</h2>
      </div>
      <ul>
        {companyProfile.engineeringNotes.map((item) => <li>{item}</li>)}
      </ul>
      <p>本站内容以中文采购、工程师、设备厂和设计院阅读习惯组织。涉及屏蔽效能、流场指标、密封效果等性能数据时，应结合图纸、样品和测试条件确认。</p>
    </div>
  </section>

  <CTASection title="了解产品和定制能力" lead="可从产品中心或联系页面提交材料、尺寸、图纸和应用场景。" />
</BaseLayout>

<style>
  .page-head {
    margin-top: 24px;
  }

  .info-card,
  .note-block,
  .info-panel {
    border: 1px solid var(--color-border);
    background: #fff;
  }

  .info-card {
    padding: 24px;
  }

  .compact-card {
    min-height: 118px;
  }

  .info-card h3,
  .info-panel h3 {
    margin: 0 0 10px;
    color: var(--color-primary);
    font-size: 21px;
  }

  .compact-card h3 {
    font-size: 18px;
    line-height: 1.35;
  }

  .info-card p,
  .info-panel p,
  .note-block > p,
  .note-block li,
  .info-panel li {
    color: var(--color-muted);
  }

  .capability-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 32px;
    align-items: start;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag-list span {
    padding: 9px 12px;
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-primary);
    font-weight: 800;
  }

  .info-panel,
  .note-block {
    padding: 28px;
  }

  .info-panel ul,
  .note-block ul {
    display: grid;
    gap: 10px;
    margin: 0 0 18px;
    padding-left: 18px;
  }

  .note-block > p {
    margin: 0;
  }

  @media (max-width: 980px) {
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
