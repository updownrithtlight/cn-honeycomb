---
const { title, description, href = "/products/" } = Astro.props;
---
<article class="product-card">
  <span class="card-line" aria-hidden="true"></span>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a class="card-link" href={href}>查看产品详情</a>
</article>

<style>
  .product-card {
    position: relative;
    min-height: 206px;
    padding: 26px;
    border: 1px solid var(--color-border);
    background: #fff;
    box-shadow: 0 10px 26px rgba(11, 42, 74, 0.05);
  }

  .card-line {
    display: block;
    width: 42px;
    height: 4px;
    margin-bottom: 18px;
    background: var(--color-accent);
  }

  h3 {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 20px;
    line-height: 1.35;
  }

  p {
    margin: 0 0 18px;
    color: var(--color-muted);
  }

  .card-link {
    color: var(--color-primary-light);
    font-size: 14px;
    font-weight: 800;
  }
</style>
