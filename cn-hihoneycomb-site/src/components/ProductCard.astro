---
const { title, description, href = "/products/", image, imageAlt = `${title}产品图` } = Astro.props;
---
<article class="product-card">
  {image && <a class="product-card__image" href={href} aria-label={title}><img src={image} alt={imageAlt} width="1254" height="1254" loading="lazy" decoding="async" /></a>}
  <div class="product-card__body">
    <span class="card-line" aria-hidden="true"></span>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="card-link" href={href}>查看产品详情</a>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #fff;
    box-shadow: 0 10px 26px rgba(11, 42, 74, 0.05);
  }

  .product-card__image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 12px;
    background: #f7f8fa;
  }

  .product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 220ms ease;
  }

  .product-card__image:hover img { transform: scale(1.025); }

  .product-card__body { padding: 24px 26px 26px; }

  .card-line {
    display: block;
    width: 42px;
    height: 4px;
    margin-bottom: 18px;
    background: var(--color-accent);
  }

  h3 {
    margin: 0 0 12px;
    color: var(--color-primary);
    font-size: 20px;
    line-height: 1.35;
  }

  p {
    margin: 0 0 18px;
    color: var(--color-muted);
  }

  .card-link {
    color: var(--color-primary-light);
    font-size: 14px;
    font-weight: 800;
  }
</style>
