---
const { title, description } = Astro.props;
---
<article class="application-card">
  <h3>{title}</h3>
  <p>{description}</p>
</article>

<style>
  .application-card {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-left: 5px solid var(--color-accent);
    background: #fff;
  }

  h3 {
    margin: 0 0 8px;
    color: var(--color-primary);
    font-size: 19px;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
