---
const { title = "需要按图纸定制金属蜂窝？", lead = "请提供材料、尺寸、孔径、厚度、数量和应用环境，我们将根据项目要求沟通加工方案。" } = Astro.props;
---
<section class="cta-section">
  <div class="container cta-inner">
    <div>
      <p class="eyebrow">Inquiry</p>
      <h2>{title}</h2>
      <p>{lead}</p>
    </div>
    <a class="button" href="/contact/">联系询盘</a>
  </div>
</section>

<style>
  .cta-section {
    padding: 48px 0;
    background:
      linear-gradient(120deg, rgba(245, 158, 11, 0.12), rgba(255, 255, 255, 0)),
      var(--color-primary);
    color: #fff;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  h2 {
    margin: 0 0 8px;
    font-size: clamp(26px, 4vw, 34px);
    letter-spacing: 0;
  }

  p {
    max-width: 760px;
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
  }

  @media (max-width: 760px) {
    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
