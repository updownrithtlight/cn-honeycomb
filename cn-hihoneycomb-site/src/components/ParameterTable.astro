---
const { rows = [] } = Astro.props;
---
<div class="table-wrap">
  <table class="parameter-table">
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>{row.value}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    background: #fff;
  }

  .parameter-table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 15px 16px;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }

  th {
    width: 190px;
    background: var(--color-bg-soft);
    color: var(--color-primary);
  }

  td {
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .table-wrap {
      overflow: visible;
      border: 0;
      background: transparent;
    }

    .parameter-table,
    .parameter-table tbody,
    .parameter-table tr,
    .parameter-table th,
    .parameter-table td {
      display: block;
      width: 100%;
      min-width: 0;
    }

    .parameter-table tr {
      margin-bottom: 12px;
      border: 1px solid var(--color-border);
      background: #fff;
    }

    .parameter-table th,
    .parameter-table td {
      padding: 12px 14px;
      border-bottom: 0;
    }

    .parameter-table th {
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
