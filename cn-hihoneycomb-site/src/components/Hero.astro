---
const { eyebrow, title, lead, actions = [], image = "/images/placeholder-metal-honeycomb.svg", imageAlt = "金属蜂窝结构占位图" } = Astro.props;
---
<section class="hero">
  <div class="container hero-grid">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="hero-lead">{lead}</p>
      {actions.length > 0 && (
        <div class="button-row">
          {actions.map((action) => <a class={`button ${action.variant === "ghost" ? "button--ghost" : ""}`} href={action.href}>{action.label}</a>)}
        </div>
      )}
      <ul class="hero-points">
        <li>按图纸定制</li>
        <li>材料与工艺可选</li>
        <li>面向工程项目询盘</li>
      </ul>
    </div>
    <figure class="hero-figure">
      <img src={image} alt={imageAlt} loading="eager" />
      <figcaption>占位图：后续替换为真实产品、工艺或应用现场图片。</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 88px 0 76px;
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(120deg, rgba(11, 42, 74, 0.08), rgba(245, 158, 11, 0.08)),
      var(--color-bg-soft);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(330px, 0.75fr);
    align-items: center;
    gap: 54px;
  }

  h1 {
    max-width: 820px;
    margin: 0 0 20px;
    color: var(--color-primary);
    font-size: clamp(38px, 6vw, 60px);
    line-height: 1.12;
    letter-spacing: 0;
  }

  .hero-lead {
    max-width: 740px;
    margin: 0;
    color: var(--color-muted);
    font-size: 18px;
  }

  .hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-points li {
    padding: 7px 11px;
    border: 1px solid rgba(11, 42, 74, 0.16);
    background: rgba(255, 255, 255, 0.72);
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 700;
  }

  .hero-figure {
    margin: 0;
    border: 1px solid rgba(11, 42, 74, 0.15);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .hero-figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--color-primary);
  }

  figcaption {
    padding: 12px 14px;
    color: var(--color-muted);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
