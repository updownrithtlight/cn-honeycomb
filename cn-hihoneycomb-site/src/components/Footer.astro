---
import { footerProductNavigation } from "../data/navigation";
import { applications } from "../data/applications";
import { siteInfo } from "../data/site";

const applicationLinks = applications.slice(0, 4).map((item) => ({
  href: "/applications/",
  label: item.name
}));
---
<footer class="site-footer">
  <div class="container footer-grid">
    <section class="footer-about">
      <h2>{siteInfo.companyName}</h2>
      <p>{siteInfo.description}</p>
      <a class="english-link" href={siteInfo.englishSite} rel="alternate" hreflang="en">English Website</a>
    </section>
    <section>
      <h2>产品快速链接</h2>
      <ul>
        {footerProductNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </section>
    <section>
      <h2>应用领域</h2>
      <ul>
        {applicationLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </section>
    <section>
      <h2>联系方式</h2>
      <p>请提供材料、尺寸、孔径、厚度、数量、图纸或应用环境，便于评估加工方案。</p>
      <p>业务电话：<a href={`tel:${siteInfo.phone}`}>{siteInfo.phone}</a></p>
      <p>邮箱：<a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></p>
      <p>{siteInfo.address}</p>
      <p><a href="/contact/">联系询盘</a></p>
      <p><a href="/technical/">技术文章</a></p>
      <p><a href="/news/">企业新闻</a></p>
      <p><a href="/sitemap.xml">Sitemap</a></p>
    </section>
  </div>
  <div class="container footer-bottom">
    <p>Copyright © {siteInfo.siteName}. All rights reserved.</p>
    <p class="legal-links">
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">冀ICP备20018495号-2</a>
      <a href="/privacy/">隐私政策</a>
      <a href="/terms/">使用条款</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 54px 0 26px;
    background: var(--color-primary);
    color: #fff;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 34px;
  }

  h2 {
    margin: 0 0 14px;
    font-size: 17px;
    line-height: 1.35;
  }

  p,
  li {
    color: rgba(255, 255, 255, 0.74);
  }

  p {
    margin: 0 0 10px;
  }

  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a:hover {
    color: #FBBF24;
  }

  .english-link {
    display: inline-flex;
    margin-top: 10px;
    color: #FBBF24;
    font-weight: 800;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 36px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 14px;
  }

  .legal-links {
    display: flex;
    gap: 16px;
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid,
    .footer-bottom {
      grid-template-columns: 1fr;
      flex-direction: column;
    }
  }
</style>
