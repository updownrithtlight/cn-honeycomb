---
import type { HeroSlide } from "../data/home";
import { existsSync } from "node:fs";
import { join } from "node:path";

const { slides = [] } = Astro.props as { slides: HeroSlide[] };
const fallbackImage = "/images/product-honeycomb-illustration.svg";
const responsiveWidths = [640, 960];
const resolveImage = (image: string) => {
  const imagePath = join(process.cwd(), "public", image.replace(/^\//, ""));
  return existsSync(imagePath) ? image : fallbackImage;
};
const buildSrcset = (image: string, sourceWidth: number) => {
  const extensionIndex = image.lastIndexOf(".");
  const base = extensionIndex >= 0 ? image.slice(0, extensionIndex) : image;
  const extension = extensionIndex >= 0 ? image.slice(extensionIndex) : "";
  const candidates = responsiveWidths
    .map((width) => ({ width, image: `${base}-${width}${extension}` }))
    .filter(({ image }) => existsSync(join(process.cwd(), "public", image.replace(/^\//, ""))));
  return [...candidates, { width: sourceWidth, image }]
    .map((candidate) => `${candidate.image} ${candidate.width}w`)
    .join(", ");
};
const resolvedSlides = slides.map((slide) => ({
  ...slide,
  resolvedImage: resolveImage(slide.image),
  resolvedSrcset: buildSrcset(resolveImage(slide.image), slide.imageWidth)
}));
---
<section class="hero-carousel" data-hero-carousel data-interval="5000">
  <div class="container carousel-shell">
    <div class="carousel-frame" aria-roledescription="carousel" aria-label="首页产品系列轮播">
      <div class="slides">
        {resolvedSlides.map((slide, index) => (
          <article class={`slide ${index === 0 ? "is-active" : ""}`} data-slide aria-hidden={index === 0 ? "false" : "true"}>
            <div class="slide-content">
              <p class="eyebrow">恒实蜂窝 · 金属蜂窝定制制造</p>
              {index === 0 ? <h1>{slide.title}</h1> : <h2>{slide.title}</h2>}
              <p>{slide.description}</p>
              <div class="slide-actions">
                <a class="button" href={slide.href}>{slide.cta}</a>
                <a class="text-link" href="/contact/">咨询定制 <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <div class="visual-stage">
              <span class="stage-ring" aria-hidden="true"></span>
              <span class="stage-line stage-line--top" aria-hidden="true"></span>
              <span class="stage-line stage-line--bottom" aria-hidden="true"></span>
              <figure>
                <img
                  src={index === 0 ? slide.resolvedImage : undefined}
                  srcset={index === 0 ? slide.resolvedSrcset : undefined}
                  sizes="(max-width: 620px) calc(100vw - 40px), (max-width: 980px) min(calc(100vw - 96px), 460px), 560px"
                  data-src={slide.resolvedImage}
                  data-srcset={slide.resolvedSrcset}
                  data-fallback={fallbackImage}
                  alt={slide.imageAlt}
                  width={slide.imageWidth}
                  height={slide.imageHeight}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "low"}
                  decoding="async"
                />
              </figure>
              <p class="stage-caption">ENGINEERED METAL HONEYCOMB</p>
            </div>
          </article>
        ))}
      </div>

      <div class="carousel-controls" aria-label="轮播控制">
        <button class="arrow" type="button" data-prev aria-label="上一张">‹</button>
        <div class="dots" role="tablist" aria-label="选择产品系列">
          {slides.map((slide, index) => (
            <button
              class={index === 0 ? "is-active" : ""}
              type="button"
              data-dot={index}
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-label={`切换到${slide.title}`}
            ></button>
          ))}
        </div>
        <button class="arrow" type="button" data-next aria-label="下一张">›</button>
        <span class="slide-count" aria-hidden="true"><strong data-current>01</strong> / {String(slides.length).padStart(2, "0")}</span>
      </div>
    </div>
  </div>
</section>

<script>
  const carousels = document.querySelectorAll("[data-hero-carousel]");

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll("[data-slide]"));
    const dots = Array.from(carousel.querySelectorAll("[data-dot]"));
    const prev = carousel.querySelector("[data-prev]");
    const next = carousel.querySelector("[data-next]");
    const currentLabel = carousel.querySelector("[data-current]");
    const interval = Number(carousel.getAttribute("data-interval")) || 5000;
    let current = 0;
    let timer = null;
    let preloadTimer = null;

    carousel.querySelectorAll("img[data-fallback]").forEach((image) => {
      image.addEventListener("error", () => {
        const fallback = image.getAttribute("data-fallback");
        if (fallback && image.getAttribute("src") !== fallback) {
          image.removeAttribute("srcset");
          image.removeAttribute("data-srcset");
          image.setAttribute("src", fallback);
        }
      }, { once: true });
    });

    const loadSlide = (index) => {
      const slide = slides[(index + slides.length) % slides.length];
      const image = slide?.querySelector("img[data-src]");
      if (!image || image.getAttribute("src")) return;
      const srcset = image.getAttribute("data-srcset");
      if (srcset) image.setAttribute("srcset", srcset);
      image.setAttribute("src", image.getAttribute("data-src"));
    };

    const preloadNext = () => {
      if (preloadTimer) window.clearTimeout(preloadTimer);
      preloadTimer = window.setTimeout(() => loadSlide(current + 1), Math.min(2500, interval / 2));
    };

    const setActive = (index) => {
      current = (index + slides.length) % slides.length;
      loadSlide(current);
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === current;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });
      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === current;
        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-selected", active ? "true" : "false");
      });
      if (currentLabel) currentLabel.textContent = String(current + 1).padStart(2, "0");
      preloadNext();
    };

    const stop = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = () => {
      stop();
      if (!document.hidden && slides.length > 1) {
        timer = window.setInterval(() => setActive(current + 1), interval);
      }
    };

    prev?.addEventListener("click", () => {
      setActive(current - 1);
      start();
    });

    next?.addEventListener("click", () => {
      setActive(current + 1);
      start();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        setActive(Number(dot.getAttribute("data-dot")));
        start();
      });
    });

    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", start);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stop();
        if (preloadTimer) {
          window.clearTimeout(preloadTimer);
          preloadTimer = null;
        }
      } else {
        start();
        preloadNext();
      }
    });

    setActive(0);
    start();
  });
</script>

<style>
  .hero-carousel {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background:
      radial-gradient(circle at 82% 42%, rgba(36, 107, 159, 0.28), transparent 29%),
      linear-gradient(112deg, #061a2f 0%, #0a2b49 58%, #0b365a 100%),
      var(--color-primary);
    color: #fff;
  }

  .hero-carousel::before {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
    opacity: 0.12;
    background-image:
      linear-gradient(30deg, transparent 48%, rgba(255,255,255,0.18) 49%, rgba(255,255,255,0.18) 51%, transparent 52%),
      linear-gradient(150deg, transparent 48%, rgba(255,255,255,0.18) 49%, rgba(255,255,255,0.18) 51%, transparent 52%);
    background-size: 48px 84px;
    mask-image: linear-gradient(90deg, transparent 55%, #000 100%);
  }

  .carousel-shell {
    position: relative;
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .eyebrow {
    color: #FBBF24;
  }

  .carousel-frame {
    position: relative;
    min-height: 610px;
  }

  .slides {
    position: relative;
    min-height: 610px;
  }

  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(480px, 1.14fr);
    gap: clamp(48px, 7vw, 100px);
    align-items: center;
    padding: 54px 16px 86px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .slide.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  .slide-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    min-width: 0;
  }

  h1,
  h2 {
    margin: 0;
    max-width: 620px;
    font-size: clamp(42px, 5.2vw, 66px);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .slide-content > p:not(.eyebrow) {
    max-width: 520px;
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 18px;
    line-height: 1.85;
  }

  .slide-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 10px;
  }

  .text-link { color: rgba(255, 255, 255, 0.88); font-weight: 800; }
  .text-link:hover { color: #FBBF24; }

  .visual-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 500px;
  }

  .stage-ring {
    position: absolute;
    width: min(41vw, 500px);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    box-shadow:
      0 0 0 34px rgba(255, 255, 255, 0.025),
      0 0 0 68px rgba(255, 255, 255, 0.018);
  }

  .stage-line {
    position: absolute;
    z-index: 2;
    width: 92px;
    height: 1px;
    background: rgba(251, 191, 36, 0.72);
  }

  .stage-line--top { top: 64px; right: 8px; }
  .stage-line--bottom { bottom: 68px; left: 12px; }

  figure {
    position: relative;
    z-index: 1;
    margin: 0;
    width: min(100%, 560px);
    max-height: 470px;
    overflow: hidden;
    border-radius: 24px 4px 24px 4px;
    background: transparent;
    box-shadow:
      0 34px 70px rgba(0, 0, 0, 0.34),
      0 0 0 1px rgba(255, 255, 255, 0.14);
    transform: translateY(-8px);
  }

  img {
    width: 100%;
    max-height: 470px;
    height: auto;
    object-fit: contain;
  }

  .stage-caption {
    position: absolute;
    right: 14px;
    bottom: 48px;
    z-index: 3;
    margin: 0;
    color: rgba(255, 255, 255, 0.42);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    writing-mode: vertical-rl;
  }

  .carousel-controls {
    position: absolute;
    left: 16px;
    bottom: 38px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .arrow,
  .dots button {
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.34);
    background: transparent;
    color: #fff;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    font-size: 22px;
    line-height: 1;
  }

  .arrow:hover,
  .dots button:hover,
  .dots button.is-active {
    border-color: #FBBF24;
    background: #F59E0B;
    color: #111827;
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots button {
    width: 24px;
    height: 3px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: rgba(255, 255, 255, 0.22);
  }

  .dots button:hover,
  .dots button.is-active {
    background: #FBBF24;
  }

  .slide-count { margin-left: 6px; color: rgba(255,255,255,0.42); font-size: 13px; }
  .slide-count strong { color: #fff; }

  @media (max-width: 980px) {
    .carousel-shell {
      padding-top: 32px;
      padding-bottom: 32px;
    }

    .carousel-frame,
    .slides {
      min-height: 800px;
    }

    .slide {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(330px, 1fr);
      gap: 18px;
      padding: 34px 24px 88px;
    }

    .visual-stage { min-height: 390px; }
    .stage-ring { width: min(70vw, 430px); }
    figure { width: min(100%, 460px); }
  }

  @media (max-width: 620px) {
    .carousel-shell {
      width: min(100% - 24px, var(--content-width));
      padding-top: 18px;
      padding-bottom: 18px;
    }

    .carousel-frame,
    .slides {
      min-height: 760px;
    }

    .slide {
      padding: 26px 8px 78px;
    }

    .carousel-controls {
      right: auto;
      bottom: 16px;
      left: 8px;
    }

    h1, h2 { font-size: 36px; }
    .slide-content > p:not(.eyebrow) { font-size: 16px; }
    .visual-stage { min-height: 330px; }
    .stage-line, .stage-caption { display: none; }
  }
</style>
