---
const { article } = Astro.props;
const href = `/technical/${article.data.slug}/`;
---
<article class="technical-card">
  <a class="technical-card__body" href={href}>
    <div class="technical-card__meta">
      <span>{article.data.category}</span>
      <time datetime={article.data.publishDate}>{article.data.publishDate}</time>
    </div>
    <h3>{article.data.title}</h3>
    <p>{article.data.description}</p>
    <ul aria-label="文章标签">
      {article.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
    </ul>
    <strong>阅读全文 <span aria-hidden="true">→</span></strong>
  </a>
</article>

<style>
  .technical-card {
    min-width: 0;
    border: 1px solid var(--color-border);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .technical-card__body {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 24px;
  }

  .technical-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--color-muted);
    font-size: 13px;
  }

  .technical-card__meta span {
    color: var(--color-accent-dark);
    font-weight: 800;
  }

  h3 {
    margin: 14px 0 10px;
    color: var(--color-primary);
    font-size: 21px;
    line-height: 1.4;
  }

  p {
    margin: 0 0 18px;
    color: var(--color-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 18px;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 5px 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-soft);
    color: var(--color-muted);
    font-size: 12px;
  }

  strong {
    color: var(--color-primary);
  }

  .technical-card__body:hover h3,
  .technical-card__body:hover strong {
    color: var(--color-accent-dark);
  }
</style>
