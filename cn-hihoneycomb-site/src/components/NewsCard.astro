---
const { title, date, excerpt, href, image, imageAlt = "" } = Astro.props;
---
<article class:list={["news-card", { "news-card--text-only": !image }]}>
  {image && <a class="news-image" href={href} aria-label={title}><img src={image} alt={imageAlt} width="1200" height="750" loading="lazy" decoding="async" /></a>}
  <div class="news-content">
    <time datetime={date}>{date}</time>
    <h3><a href={href}>{title}</a></h3>
    <p>{excerpt}</p>
    <a class="news-link" href={href}>阅读企业新闻</a>
  </div>
</article>

<style>
  .news-card {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    border: 1px solid var(--color-border);
    background: #fff;
    box-shadow: 0 10px 26px rgba(11, 42, 74, 0.05);
  }

  .news-card--text-only { grid-template-columns: 1fr; }

  .news-image { display: block; min-height: 190px; overflow: hidden; background: var(--color-bg-soft); }
  .news-image img { width: 100%; height: 100%; min-height: 190px; object-fit: contain; background: var(--color-bg-soft); }
  .news-content { display: grid; gap: 12px; padding: 24px; }

  time {
    color: var(--color-accent-dark);
    font-size: 14px;
    font-weight: 800;
  }

  h3 {
    margin: 0;
    color: var(--color-primary);
    font-size: 22px;
    line-height: 1.4;
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .news-link {
    color: var(--color-primary-light);
    font-size: 14px;
    font-weight: 800;
  }

  @media (max-width: 680px) {
    .news-card { grid-template-columns: 1fr; }
    .news-image { min-height: 0; }
    .news-image img { min-height: 0; aspect-ratio: 16 / 10; }
  }
</style>
