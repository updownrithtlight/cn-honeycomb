NODE_ENV=production
HOST=0.0.0.0
PORT=4321
PUBLIC_SITE_ORIGIN=https://cn.hihoneycomb.com

# Resend email delivery
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=恒实蜂窝网站 <inquiry@cn.hihoneycomb.com>
INQUIRY_TO_EMAIL=sales@hihoneycomb.com

# Cloudflare Turnstile. The public key is required at build time.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AMap JavaScript API 2.0 Web key and security code.
PUBLIC_AMAP_JS_KEY=
PUBLIC_AMAP_SECURITY_JS_CODE=

# Development only. Do not enable in production.
ALLOW_INQUIRY_WITHOUT_CAPTCHA=false

# Enable only when HTTPS is guaranteed by the reverse proxy.
FORCE_HTTPS=false

# Optional, consent-gated analytics: ga4 or baidu
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_ID=
